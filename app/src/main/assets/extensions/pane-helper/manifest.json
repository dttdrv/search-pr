{
  "manifest_version": 2,
  "name": "Pane Helper",
  "version": "1.0.0",
  "description": "Reader View and page colours for Pane.",
  "browser_specific_settings": {
    "gecko": {
      "id": "helper@pane.app"
    }
  },
  "permissions": [
    "nativeMessaging",
    "nativeMessagingFromContent",
    "geckoViewAddons",
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "vendor/Readability-readerable.js",
        "vendor/Readability.js",
        "content.js"
      ],
      "css": ["reader.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}

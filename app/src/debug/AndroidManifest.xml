<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: a stand-in password manager the emulator smoke test switches on to check
     that web login forms reach Android autofill the way Bitwarden needs them. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <service
            android:name=".debug.ProbeAutofillService"
            android:exported="true"
            android:label="Pane Autofill Probe"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE">
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
        </service>
    </application>
</manifest>
